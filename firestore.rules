rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny-All Catch-All Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Global Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile Validation Blueprint
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'name', 'plan', 'createdAt']) &&
             data.keys().hasOnly(['id', 'email', 'name', 'plan', 'avatar', 'company', 'billingCycle', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             data.name is string && data.name.size() <= 100 &&
             data.plan in ['free', 'pro', 'enterprise'] &&
             data.createdAt is number;
    }

    // Board Validation Blueprint
    function isValidBoard(data) {
      return data.keys().hasAll(['id', 'title', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly([
               'id', 'title', 'ownerId', 'ownerName', 'category', 'isFavorite', 'isStarred',
               'isReadOnly', 'icon', 'iconBg', 'description', 'elements', 'frames', 'comments',
               'collaborators', 'elementsCount', 'thumbnail', 'createdAt', 'updatedAt', 'openedAt', 'owner'
             ]) &&
             data.id is string && isValidId(data.id) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.ownerId is string &&
             data.createdAt is number &&
             data.updatedAt is number &&
             (!('elements' in data) || data.elements is list) &&
             (!('frames' in data) || data.frames is list) &&
             (!('comments' in data) || data.comments is list) &&
             (!('collaborators' in data) || data.collaborators is list);
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Block user enumeration
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId);
    }

    // BOARDS COLLECTION
    match /boards/{boardId} {
      allow get: if isSignedIn() && isValidId(boardId) && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.collaborators is list && resource.data.collaborators.hasAny([request.auth.uid, request.auth.token.email]))
      );

      allow list: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.collaborators is list && resource.data.collaborators.hasAny([request.auth.uid, request.auth.token.email]))
      );

      allow create: if isSignedIn() && isValidId(boardId) && isValidBoard(incoming()) && incoming().ownerId == request.auth.uid;

      allow update: if isSignedIn() && isValidId(boardId) && isValidBoard(incoming()) &&
                    incoming().ownerId == existing().ownerId &&
                    incoming().createdAt == existing().createdAt &&
                    (
                      existing().ownerId == request.auth.uid ||
                      (existing().collaborators is list && existing().collaborators.hasAny([request.auth.uid, request.auth.token.email]))
                    );

      allow delete: if isSignedIn() && isValidId(boardId) && existing().ownerId == request.auth.uid;
    }

    // TEMPLATES COLLECTION (Read-only for users)
    match /templates/{templateId} {
      allow read: if true;
      allow write: if false;
    }

    // Connection testing endpoint for healthchecks
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
