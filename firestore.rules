rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny-All Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || resource.data.ownerId == request.auth.uid);
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || request.resource.data.id == request.auth.uid);
    }

    // Boards collection
    match /boards/{boardId} {
      allow read: if isSignedIn() || true; // allow reading boards with link/id
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Templates collection (Read-only for all users)
    match /templates/{templateId} {
      allow read: if true;
      allow write: if false;
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
