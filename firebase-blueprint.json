{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and subscription metadata.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User UID from Firebase Authentication"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Full display name"
        },
        "plan": {
          "type": "string",
          "enum": ["free", "pro", "enterprise"],
          "description": "Active subscription tier"
        },
        "avatar": {
          "type": "string",
          "description": "User profile avatar initial or image URL"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp in milliseconds"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last update timestamp in milliseconds"
        }
      },
      "required": ["id", "email", "name", "plan", "createdAt"]
    },
    "Board": {
      "title": "Board",
      "description": "Visual collaboration whiteboard canvas containing elements, sticky notes, diagrams and frames.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the board"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Board title"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the board creator"
        },
        "ownerName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the owner"
        },
        "category": {
          "type": "string",
          "description": "Board category (e.g. Brainstorming, Kanban, Funil, Mindmap, Wireframe)"
        },
        "isFavorite": {
          "type": "boolean",
          "description": "Whether board is bookmarked as favorite"
        },
        "elements": {
          "type": "array",
          "description": "List of canvas elements, sticky notes, connectors and shapes"
        },
        "frames": {
          "type": "array",
          "description": "List of frame containers"
        },
        "comments": {
          "type": "array",
          "description": "List of canvas comments"
        },
        "collaborators": {
          "type": "array",
          "description": "List of collaborator user IDs or emails"
        },
        "elementsCount": {
          "type": "number",
          "description": "Total count of elements on board"
        },
        "thumbnail": {
          "type": "string",
          "description": "Optional board preview image or color"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last updated timestamp"
        }
      },
      "required": ["id", "title", "ownerId", "createdAt", "updatedAt"]
    },
    "Template": {
      "title": "Template",
      "description": "Pre-configured Miro/Diorfy canvas creation model template.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique template identifier"
        },
        "title": {
          "type": "string",
          "description": "Template name"
        },
        "category": {
          "type": "string",
          "description": "Category of template"
        },
        "description": {
          "type": "string",
          "description": "Template description"
        },
        "elements": {
          "type": "array",
          "description": "Pre-built elements"
        },
        "frames": {
          "type": "array",
          "description": "Pre-built frames"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp"
        }
      },
      "required": ["id", "title", "category", "description"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User profile records and subscription state."
    },
    "/boards/{boardId}": {
      "schema": {
        "$ref": "#/entities/Board"
      },
      "description": "Visual boards collection containing elements and frames."
    },
    "/templates/{templateId}": {
      "schema": {
        "$ref": "#/entities/Template"
      },
      "description": "Ready-to-use whiteboard models and design presets."
    }
  }
}
